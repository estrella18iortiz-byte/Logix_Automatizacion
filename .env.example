# Copia este archivo como .env y llena tus datos. .env NUNCA se sube a GitHub.
LOGIX_SQL_SERVER=.\SQLEXPRESS
LOGIX_SQL_DB=logix_db
LOGIX_SQL_DRIVER=ODBC Driver 18 for SQL Server

# 1 = los avisos solo se registran (sin internet). 0 = se envían de verdad.
LOGIX_MODO_SIMULADO=1

# Buzón de facturas y avisos por correo (Gmail con contraseña de aplicación)
LOGIX_CORREO_USUARIO=
LOGIX_CORREO_PASSWORD=

# Bot de Telegram: créalo con @BotFather y pega aquí su token
LOGIX_TELEGRAM_TOKEN=

# Lista blanca para la demostración: si tiene valor, TODOS los correos se mandan aquí.
# (En Telegram solo reciben avisos quienes se vincularon con el bot.)
LOGIX_DEMO_CORREO=
