ivo se le manda al proveedor por correo y Telegram" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FBE0DD;strokeColor=#C0392B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50.0" y="1078.0" width="280" height="84" as="geometry"/></mxCell><mxCell id="fin3" value="Fin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontColor=#FFFFFF;fontStyle=1;fillColor=#0B2545;strokeColor=#0B2545;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130.0" y="1210.0" width="120" height="40" as="geometry"/></mxCell><mxCell id="exp" value="R4: expediente PDF con SHA-256 llega a Recursos Financieros" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#D8F3FC;strokeColor=#00A8E8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420.0" y="930.0" width="280" height="60" as="geometry"/></mxCell><mxCell id="pay" value="R5: pago automático al banco emulado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF1CC;strokeColor=#C48A00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420.0" y="1042.0" width="280" height="56" as="geometry"/></mxCell><mxCell id="db" value="¿El banco confirma?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF1CC;strokeColor=#C48A00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="455.0" y="1145.0" width="210" height="110" as="geometry"/></mxCell><mxCell id="conf" value="Mensaje al proveedor: pago confirmado (clave SPEI); aviso a Adquisiciones y Finanzas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#D8F3FC;strokeColor=#00A8E8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420.0" y="1315.0" width="280" height="70" as="geometry"/></mxCell><mxCell id="fin4" value="Fin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fontColor=#FFFFFF;fontStyle=1;fillColor=#0B2545;strokeColor=#0B2545;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500.0" y="1440.0" width="120" height="40" as="geometry"/></mxCell><mxCell id="dg" value="¿Error general y menos de 3 intentos?" style="rhombus;whiteSpace=wrap;html=